#!/bin/bash
set -euo pipefail

# This script re-runs automatically whenever any Brewfile's contents change,
# because the hashes below are embedded by chezmoi's template engine.
#
# Brewfile hashes (do not edit — regenerated by chezmoi):
# core:       {{ include "dot_Brewfiles/private_Brewfile.core" | sha256sum }}
# dev:        {{ include "dot_Brewfiles/private_Brewfile.dev" | sha256sum }}
# containers: {{ include "dot_Brewfiles/private_Brewfile.virt" | sha256sum }}
# fonts:      {{ include "dot_Brewfiles/private_Brewfile.fonts" | sha256sum }}
# mac:        {{ include "dot_Brewfiles/private_Brewfile.mac.tmpl" | sha256sum }}

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew not found — skipping package install."
  exit 0
fi

BREWFILE_DIR="$HOME/.Brewfiles"

for file in "$BREWFILE_DIR"/Brewfile.*; do
  echo "==> brew bundle install --file=$file"
  brew bundle install --file="$file"
done
