# =========================================================
# 0. BASE SHELL BEHAVIOR
# =========================================================

# Histroy settings
export HISTFILE=~/.zsh_history
export HISTSIZE=100000
export SAVEHIST=100000
setopt interactive_comments
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

# Search history
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# Autocompletion configuration
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
autoload -Uz compinit
compinit

# =========================================================
# 1. ENVIRONMENT
# =========================================================

# Homebrew init
{{- if stat "/opt/homebrew/bin/brew" }}
eval "$(/opt/homebrew/bin/brew shellenv zsh)"
{{- end }}
{{- if stat "/home/linuxbrew/.linuxbrew/bin/brew" }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
{{- end }}

export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
alias cdp='cd /Users/anton/projects'

# Navigation

export WORDCHARS="*?_-.[]~=&;!#$%^(){}<>"
bindkey "^[^H" backward-kill-word
bindkey "^[^?" backward-kill-word

{{- if lookPath "mise" }}
eval "$(mise activate zsh)"
{{- end }}
fpath=(~/.local/share/zsh/site-functions $fpath)

{{- if eq .chezmoi.os "darwin" }}
export SSH="kitten ssh"
export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
export LIMA_INSTANCE="agent-vm"
alias ssh='kitten ssh'
{{- end }}

{{- if (.chezmoi.hostname | contains "agent-vm") }}
export PATH="$HOME/.opencode/bin:$PATH"
{{- end }}

{{- if lookPath "direnv" }}
eval "$(direnv hook zsh)"
{{- end }}

{{- if lookPath "zoxide" }}
eval "$(zoxide init zsh)"
alias cd=z
{{- end }}

# =========================================================
# 5. FUZZY FINDER (fzf)
# =========================================================

{{- if lookPath "fzf" }}
source <(fzf --zsh)
export FZF_DEFAULT_OPTS="
  --height=60%
  --layout=reverse
  --border
  --cycle
  --scroll-off=5
  --ansi
"
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
export FZF_CTRL_T_OPTS="
  --preview 'bat --style=numbers --color=always --line-range :500 {}'
"
fzf-cd-widget() {
  local dir
  dir=$(fd --type d --hidden --follow --exclude .git | fzf \
    --preview 'eza --tree --level=2 --color=always {}')
  [[ -n "$dir" ]] && cd "$dir"
}
zle -N fzf-cd-widget
bindkey '^[c' fzf-cd-widget

fzf-history-widget() {
    local cmd

    cmd=$(fc -ln 1 | fzf \
        --tac \
        --height=60% \
        --layout=reverse \
        --border) || return

    BUFFER="$cmd"
    CURSOR=${#BUFFER}
    zle redisplay
}
zle -N fzf-history-widget
bindkey '^R' fzf-history-widget
{{- end }}

# =========================================================
# 6. PROMPT
# =========================================================

{{- if lookPath "starship" }}
eval "$(starship init zsh)"
{{- end }}

for f in ~/.zsh/*.zsh; do
  source "$f"
done
