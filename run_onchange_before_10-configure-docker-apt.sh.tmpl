{{- if and (eq .chezmoi.os "linux") (eq .machineType "personal") -}}
#!/bin/bash
set -euo pipefail

# https://docs.docker.com/engine/install/ubuntu/#install-using-the-apt-repository
. /etc/os-release
if [ "$ID" != ubuntu ]; then
  echo "The Docker apt repository configuration requires Ubuntu." >&2
  exit 1
fi

sudo apt-get update --error-on=any
sudo apt-get install -y --no-install-recommends ca-certificates curl

repo_tmp=$(mktemp -d)
trap 'rm -rf "$repo_tmp"' EXIT
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o "$repo_tmp/docker.asc"
cat > "$repo_tmp/docker.sources" <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: ${UBUNTU_CODENAME:-$VERSION_CODENAME}
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
sudo install -d -m 0755 /etc/apt/keyrings
sudo install -m 0644 "$repo_tmp/docker.asc" /etc/apt/keyrings/docker.asc
sudo install -m 0644 "$repo_tmp/docker.sources" /etc/apt/sources.list.d/docker.sources
{{- end }}
